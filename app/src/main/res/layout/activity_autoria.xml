<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- ── Logo + nome ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- TODO:Logo (ImageView: substitua pelo drawable real) -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Logo do app"
                android:src="@drawable/coreaninha_joia" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="InvestimentoApp"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Versão 1.0.0"
                android:textColor="@color/muted_foreground"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- ── Sobre o app ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="SOBRE O APP"
                android:textColor="@color/muted_foreground"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:text="O InvestimentoApp é um aplicativo pessoal para controle de investimentos. Permite registrar corretoras, cadastrar ativos financeiros e acompanhar o histórico de aportes e resgates, mantendo o saldo de cada posição sempre atualizado."
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:text="ESTOU FAZENDO A TROCA DE TEMA PARA FICAR BONITINHO!"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.5"
                android:text="Desenvolvido como projeto acadêmico para a disciplina de Desenvolvimento Java Para Dispositivo Móveis, com foco em usabilidade minimalista e layout criado no Figma para aprendizado pessoal."
                android:textColor="@color/muted_foreground"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- ── Desenvolvedor ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:letterSpacing="0.12"
                android:text="DESENVOLVEDOR"
                android:textColor="@color/muted_foreground"
                android:textSize="10sp" />

            <!-- Avatar + nome -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/coreaninha"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tayssa Asakawa"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="QA / Futura Dev"
                        android:textColor="@color/muted_foreground"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Email"
                    android:src="@drawable/ic_email"
                    android:tint="@color/muted_foreground" />

                <TextView
                    android:id="@+id/tv_dev_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tayssa.asakawa@hotmail.com"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_linkedin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="LinkedIn"
                    android:src="@drawable/ic_linkedin"
                    android:tint="@color/muted_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="linkedin.com/in/tayssa-asakawa"
                    android:textColor="#0A66C2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- ── Instituição ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.12"
                android:text="INSTITUIÇÃO"
                android:textColor="@color/muted_foreground"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="39dp"
                    android:layout_height="57dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="utfpr"
                    android:src="@drawable/utfpr"
                    android:tint="@color/muted_foreground" />

                <TextView
                    android:id="@+id/tv_inst_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Universidade Tecnológica Federal do Paraná"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Curso de Especialização em Tecnologia Java - Turma XXXIII"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Disciplina: Desenvolvimento Java para Dispositivo Móveis"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bloco 4"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ── Rodapé ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="© 2026 Tayssa Asakawa · Todos os direitos reservados (chique falar isso)"
            android:textColor="@color/muted_foreground"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
