<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: garante rolagem quando o formulário excede o tamanho da tela -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- ── TextView + EditText: Nome do Produto ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_nome_produto"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_nome_produto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nome_produto"
            android:textSize="14sp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/muted_foreground"
            android:background="@null"
            android:paddingBottom="8dp"
            android:inputType="textCapWords"
            android:imeOptions="actionNext"
            android:layout_marginBottom="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="20dp" />

        <!-- ── TextView + EditText: Valor Inicial ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_valor_inicial"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_valor_inicial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_valor"
            android:textSize="14sp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/muted_foreground"
            android:background="@null"
            android:paddingBottom="8dp"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:layout_marginBottom="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="20dp" />

        <!-- ── TextView + Spinner: Categoria ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_categoria"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:paddingBottom="8dp"
            android:entries="@array/categorias"
            android:layout_marginBottom="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="20dp" />

        <!-- ── TextView + Spinner: Instituição ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_instituicao"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_instituicao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:paddingBottom="8dp"
            android:entries="@array/instituicoes"
            android:layout_marginBottom="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="20dp" />

        <!-- ── TextView + RadioGroup: Tipo de Renda ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_tipo_renda"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_tipo_renda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rb_renda_fixa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/radio_renda_fixa"
                android:textSize="14sp"
                android:textColor="@color/foreground"
                android:buttonTint="@color/foreground" />

            <RadioButton
                android:id="@+id/rb_renda_variavel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/radio_renda_variavel"
                android:textSize="14sp"
                android:textColor="@color/foreground"
                android:buttonTint="@color/foreground" />

        </RadioGroup>

        <!-- ── CheckBox: Favorito ── -->
        <CheckBox
            android:id="@+id/cb_favorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_favorito"
            android:textSize="14sp"
            android:textColor="@color/foreground"
            android:buttonTint="@color/foreground"
            android:layout_marginBottom="20dp" />

        <!-- ── TextView + EditText: Anotações ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_anotacoes"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_anotacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_anotacoes"
            android:textSize="14sp"
            android:textColor="@color/foreground"
            android:textColorHint="@color/muted_foreground"
            android:background="@null"
            android:paddingBottom="8dp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="32dp" />

        <!-- ── 2 Buttons: Limpar e Salvar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Button com rótulo "Limpar" -->
            <Button
                android:id="@+id/btn_limpar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_limpar"
                style="@style/Widget.InvstApp.Button.Outlined" />

            <!-- Button com rótulo "Salvar" -->
            <Button
                android:id="@+id/btn_salvar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_salvar"
                style="@style/Widget.InvstApp.Button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
