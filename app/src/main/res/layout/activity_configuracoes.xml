<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Título da Seção: Ordenação -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_ordenacao"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="16dp" />

        <RadioGroup
            android:id="@+id/rg_ordenacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_ordenar_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_por_nome"
                android:textSize="15sp"
                android:textColor="@color/foreground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_ordenar_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_por_valor"
                android:textSize="15sp"
                android:textColor="@color/foreground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <RadioButton
                android:id="@+id/rb_ordenar_categoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_por_categoria"
                android:textSize="15sp"
                android:textColor="@color/foreground"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="32dp" />

        <!-- Título da Seção: Preferências -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_preferencias"

            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cb_apenas_favoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_apenas_favoritos"
            android:textSize="15sp"
            android:textColor="@color/foreground"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <CheckBox
            android:id="@+id/cb_mostrar_valores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_mostrar_valores"
            android:textSize="15sp"
            android:textColor="@color/foreground"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:checked="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_info"
            android:textSize="13sp"
            android:textColor="@color/muted_foreground"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>