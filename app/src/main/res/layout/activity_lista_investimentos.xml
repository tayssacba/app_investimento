<?xml version="1.0" encoding="utf-8"?>
<!-- Listagem (layout do Figma): patrimônio total, mini gráfico + legenda, contador e ListView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Patrimônio total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/patrimonio_total"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_patrimonio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:textColor="@color/foreground"
            android:textSize="32sp"
            tools:text="R$ 0,00" />

    </LinearLayout>

    <!-- Gráfico + legenda por categoria -->
    <LinearLayout
        android:id="@+id/bloco_grafico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <edu.utfpr.investimentoapp.GraficoCategoriasView
            android:id="@+id/grafico"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/cd_grafico" />

        <GridLayout
            android:id="@+id/grid_legenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:columnCount="2" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Quantidade de ativos exibidos -->
    <TextView
        android:id="@+id/tv_qtd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:textColor="@color/muted_foreground"
        android:textSize="12sp"
        tools:text="10 ativos" />

    <!-- Estado vazio-->
    <TextView
        android:id="@+id/tv_vazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/nenhum_ativo"
        android:textColor="@color/muted_foreground"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list_view_ativos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/border"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:scrollbars="none" />

</LinearLayout>
